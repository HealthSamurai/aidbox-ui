{
	"$schema": "https://biomejs.dev/schemas/2.1.3/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"includes": [
			"src/**",
			".vscode/**",
			"biome.json",
			"index.html",
			"package.json",
			"tsconfig.app.json",
			"tsconfig.json",
			"tsconfig.node.json",
			"vite.config.ts",
			"!src/**/routeTree.gen.ts",
			"!src/components/SDCConfig/customizable-messages-schema.json",
			"scripts/**"
		],
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"domains": {
			"project": "recommended",
			"react": "recommended",
			"test": "recommended"
		},
		"rules": {
			"a11y": {
				"useKeyWithClickEvents": "warn",
				"noStaticElementInteractions": "warn"
			},
			"correctness": {
				"useExhaustiveDependencies": {
					"level": "error",
					"options": {
						"hooks": [{ "name": "useEffectEvent", "stableResult": true }]
					}
				}
			},
			"style": {
				"noNonNullAssertion": "error"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 30
					}
				}
			},
			"recommended": true
		}
	},
	"overrides": [
		{
			"includes": [
				"src/components/PlanDefinition/plan-definition-graph-edges.tsx"
			],
			"linter": {
				"rules": {
					"a11y": {
						"useSemanticElements": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
