{
	"name": "@health-samurai/aidbox-ui",
	"version": "1.2611.2",
	"description": "Aidbox UI",
	"files": [
		"dist",
		"sbom.cdx.json"
	],
	"type": "module",
	"scripts": {
		"dev": "vite",
		"typecheck": "pnpm tsc --noEmit --project tsconfig.app.json",
		"build": "pnpm exec vite build",
		"generate-sbom": "pnpm sbom --sbom-format cyclonedx --out sbom.cdx.json",
		"prepack": "pnpm run generate-sbom",
		"format": "biome format --write",
		"format:check": "biome format",
		"lint": "biome check",
		"lint:check": "biome check",
		"lint:fix": "biome check --write",
		"test": "echo \"Error: no test specified\" && exit 1",
		"all": "pnpm format && pnpm typecheck && biome check --write --diagnostic-level=error",
		"hooks": "cp .hooks/* .git/hooks/",
		"generate-types": "NODE_OPTIONS=--max-old-space-size=8192 pnpm exec tsx scripts/generate-types.ts"
	},
	"keywords": [],
	"author": "Health Samurai",
	"license": "MIT",
	"homepage": "https://github.com/HealthSamurai/aidbox-ui#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/HealthSamurai/aidbox-ui"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@12.21.0",
